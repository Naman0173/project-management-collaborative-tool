<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>TaskFlow — project boards for small teams</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div id="toast-region" class="toast-region" aria-live="polite"></div>

<!-- AUTH SCREEN -->
<section id="auth-screen" class="auth-screen">
  <div class="auth-card">
    <div class="brand">
      <span class="brand-mark">TF</span>
      <span class="brand-name">TaskFlow</span>
    </div>
    <p class="auth-tagline">Boards, tickets, and threaded comments for teams who'd rather be shipping.</p>

    <div class="auth-tabs" role="tablist">
      <button class="auth-tab active" data-tab="login" role="tab">Sign in</button>
      <button class="auth-tab" data-tab="register" role="tab">Create account</button>
    </div>

    <form id="login-form" class="auth-form">
      <label for="login-email">Email</label>
      <input id="login-email" type="email" autocomplete="email" required />
      <label for="login-password">Password</label>
      <input id="login-password" type="password" autocomplete="current-password" required />
      <p class="form-error" id="login-error"></p>
      <button type="submit" class="btn btn-primary">Sign in</button>
    </form>

    <form id="register-form" class="auth-form hidden">
      <label for="register-name">Name</label>
      <input id="register-name" type="text" autocomplete="name" required />
      <label for="register-email">Email</label>
      <input id="register-email" type="email" autocomplete="email" required />
      <label for="register-password">Password</label>
      <input id="register-password" type="password" autocomplete="new-password" required minlength="6" />
      <p class="form-hint">At least 6 characters.</p>
      <p class="form-error" id="register-error"></p>
      <button type="submit" class="btn btn-primary">Create account</button>
    </form>
  </div>
</section>

<!-- APP SHELL -->
<div id="app-shell" class="app-shell hidden">
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark">TF</span>
      <span class="brand-name">TaskFlow</span>
    </div>
    <nav class="topbar-projects" id="project-switcher"></nav>
    <div class="topbar-right">
      <span class="current-user" id="current-user-name"></span>
      <button class="btn btn-ghost" id="logout-btn">Sign out</button>
    </div>
  </header>

  <main class="main-area">
    <!-- PROJECT LIST VIEW -->
    <section id="projects-view" class="projects-view">
      <div class="view-header">
        <div>
          <h1>Your projects</h1>
          <p class="view-subtitle">Ledgers for every initiative your team is running.</p>
        </div>
        <button class="btn btn-primary" id="new-project-btn">+ New project</button>
      </div>
      <div id="projects-grid" class="projects-grid"></div>
      <div id="projects-empty" class="empty-state hidden">
        <p class="empty-title">No projects yet</p>
        <p class="empty-body">Start one to get a board, a ticket queue, and a place for your team to talk.</p>
        <button class="btn btn-primary" id="empty-new-project-btn">+ New project</button>
      </div>
    </section>

    <!-- BOARD VIEW -->
    <section id="board-view" class="board-view hidden">
      <div class="view-header">
        <div>
          <button class="btn-link" id="back-to-projects">&larr; All projects</button>
          <h1 id="board-project-name"></h1>
          <p class="view-subtitle" id="board-project-desc"></p>
        </div>
        <div class="board-header-actions">
          <button class="btn btn-ghost" id="manage-members-btn">Members</button>
          <button class="btn btn-primary" id="new-task-btn">+ New ticket</button>
        </div>
      </div>

      <div class="board-columns">
        <div class="board-column" data-status="todo">
          <div class="column-header">
            <span class="column-title">To do</span>
            <span class="column-count" id="count-todo">0</span>
          </div>
          <div class="column-body" id="column-todo"></div>
        </div>
        <div class="board-column" data-status="in_progress">
          <div class="column-header">
            <span class="column-title">In progress</span>
            <span class="column-count" id="count-in_progress">0</span>
          </div>
          <div class="column-body" id="column-in_progress"></div>
        </div>
        <div class="board-column" data-status="done">
          <div class="column-header">
            <span class="column-title">Done</span>
            <span class="column-count" id="count-done">0</span>
          </div>
          <div class="column-body" id="column-done"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<!-- NEW PROJECT MODAL -->
<div id="project-modal" class="modal-overlay hidden">
  <div class="modal">
    <div class="modal-header">
      <h2>New project</h2>
      <button class="modal-close" data-close="project-modal">&times;</button>
    </div>
    <form id="project-form">
      <label for="project-name">Project name</label>
      <input id="project-name" type="text" required maxlength="80" />
      <label for="project-desc">Description</label>
      <textarea id="project-desc" rows="3" maxlength="300" placeholder="What is this project about?"></textarea>
      <p class="form-error" id="project-error"></p>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" data-close="project-modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create project</button>
      </div>
    </form>
  </div>
</div>

<!-- MEMBERS MODAL -->
<div id="members-modal" class="modal-overlay hidden">
  <div class="modal">
    <div class="modal-header">
      <h2>Project members</h2>
      <button class="modal-close" data-close="members-modal">&times;</button>
    </div>
    <div id="members-list" class="members-list"></div>
    <form id="add-member-form" class="add-member-form">
      <label for="member-email">Add teammate by email</label>
      <div class="inline-form">
        <input id="member-email" type="email" placeholder="teammate@example.com" required />
        <button type="submit" class="btn btn-primary">Add</button>
      </div>
      <p class="form-error" id="member-error"></p>
    </form>
  </div>
</div>

<!-- TASK MODAL -->
<div id="task-modal" class="modal-overlay hidden">
  <div class="modal modal-wide">
    <div class="modal-header">
      <div>
        <span class="ticket-id" id="task-ticket-id"></span>
        <h2 id="task-modal-title">Ticket</h2>
      </div>
      <button class="modal-close" data-close="task-modal">&times;</button>
    </div>

    <div class="task-modal-body">
      <div class="task-modal-main">
        <form id="task-form">
          <label for="task-title">Title</label>
          <input id="task-title" type="text" required maxlength="120" />

          <label for="task-desc">Description</label>
          <textarea id="task-desc" rows="4" maxlength="1000" placeholder="Add details for whoever picks this up..."></textarea>

          <div class="task-form-row">
            <div>
              <label for="task-status">Status</label>
              <select id="task-status">
                <option value="todo">To do</option>
                <option value="in_progress">In progress</option>
                <option value="done">Done</option>
              </select>
            </div>
            <div>
              <label for="task-priority">Priority</label>
              <select id="task-priority">
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
              </select>
            </div>
          </div>

          <div class="task-form-row">
            <div>
              <label for="task-assignee">Assignee</label>
              <select id="task-assignee">
                <option value="">Unassigned</option>
              </select>
            </div>
            <div>
              <label for="task-due">Due date</label>
              <input id="task-due" type="date" />
            </div>
          </div>

          <p class="form-error" id="task-error"></p>
          <div class="modal-actions modal-actions-split">
            <button type="button" class="btn btn-danger-ghost" id="delete-task-btn">Delete ticket</button>
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost" data-close="task-modal">Close</button>
              <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
          </div>
        </form>
      </div>

      <div class="task-modal-comments">
        <h3>Comments</h3>
        <div id="comments-list" class="comments-list"></div>
        <form id="comment-form" class="comment-form">
          <textarea id="comment-text" rows="2" maxlength="800" placeholder="Write a comment..." required></textarea>
          <button type="submit" class="btn btn-primary btn-small">Comment</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>
