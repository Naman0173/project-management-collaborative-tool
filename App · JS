(() => {
  'use strict';

  const API = '/api';
  let state = {
    token: localStorage.getItem('taskflow_token') || null,
    user: JSON.parse(localStorage.getItem('taskflow_user') || 'null'),
    projects: [],
    currentProject: null,
    tasks: [],
    currentTaskId: null,
    draggingTaskId: null
  };

  // ------------------------------ helpers ---------------------------------

  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

  function toast(message, isError = false) {
    const region = $('#toast-region');
    const el = document.createElement('div');
    el.className = 'toast' + (isError ? ' toast-error' : '');
    el.textContent = message;
    region.appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  function initials(name) {
    if (!name) return '?';
    return name.trim().split(/\s+/).slice(0, 2).map(w => w[0].toUpperCase()).join('');
  }

  function formatDate(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }

  function ticketRef(taskId) {
    // Turn an internal id like task_xxxxxxxx into a short display ref, e.g. TCK-XXXXXX
    const tail = taskId.replace('task_', '').replace(/-/g, '').slice(0, 6).toUpperCase();
    return `TCK-${tail}`;
  }

  async function api(path, { method = 'GET', body } = {}) {
    const headers = { 'Content-Type': 'application/json' };
    if (state.token) headers.Authorization = `Bearer ${state.token}`;

    let res;
    try {
      res = await fetch(`${API}${path}`, {
        method,
        headers,
        body: body !== undefined ? JSON.stringify(body) : undefined
      });
    } catch (networkErr) {
      throw new Error('Could not reach the server. Is the backend running?');
    }

    let data = {};
    try { data = await res.json(); } catch (e) { /* empty body */ }

    if (!res.ok) {
      if (res.status === 401 && state.token) {
        // token expired/invalid — send back to login
        signOut();
      }
      throw new Error(data.error || `Request failed (${res.status})`);
    }
    return data;
  }

  function persistAuth(token, user) {
    state.token = token;
    state.user = user;
    localStorage.setItem('taskflow_token', token);
    localStorage.setItem('taskflow_user', JSON.stringify(user));
  }

  function signOut() {
    state.token = null;
    state.user = null;
    localStorage.removeItem('taskflow_token');
    localStorage.removeItem('taskflow_user');
    showAuthScreen();
  }

  // ------------------------------ auth screen -------------------------------

  function showAuthScreen() {
    $('#auth-screen').classList.remove('hidden');
    $('#app-shell').classList.add('hidden');
  }

  function showAppShell() {
    $('#auth-screen').classList.add('hidden');
    $('#app-shell').classList.remove('hidden');
    $('#current-user-name').textContent = state.user ? state.user.name : '';
  }

  function initAuthTabs() {
    $$('.auth-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        $$('.auth-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.dataset.tab;
        $('#login-form').classList.toggle('hidden', target !== 'login');
        $('#register-form').classList.toggle('hidden', target !== 'register');
      });
    });
  }

  function initAuthForms() {
    $('#login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = $('#login-email').value.trim();
      const password = $('#login-password').value;
      $('#login-error').textContent = '';
      try {
        const data = await api('/auth/login', { method: 'POST', body: { email, password } });
        persistAuth(data.token, data.user);
        await boot();
      } catch (err) {
        $('#login-error').textContent = err.message;
      }
    });

    $('#register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('#register-name').value.trim();
      const email = $('#register-email').value.trim();
      const password = $('#register-password').value;
      $('#register-error').textContent = '';
      try {
        const data = await api('/auth/register', { method: 'POST', body: { name, email, password } });
        persistAuth(data.token, data.user);
        await boot();
      } catch (err) {
        $('#register-error').textContent = err.message;
      }
    });

    $('#logout-btn').addEventListener('click', signOut);
  }

  // ------------------------------ modal helpers -----------------------------

  function openModal(id) { $(`#${id}`).classList.remove('hidden'); }
  function closeModal(id) { $(`#${id}`).classList.add('hidden'); }

  function initModalCloses() {
    $$('[data-close]').forEach(btn => {
      btn.addEventListener('click', () => closeModal(btn.dataset.close));
    });
    $$('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.classList.add('hidden');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        $$('.modal-overlay').forEach(o => o.classList.add('hidden'));
      }
    });
  }

  // ------------------------------ projects view -----------------------------

  async function loadProjects() {
    const data = await api('/projects');
    state.projects = data.projects;
    renderProjectSwitcher();
    renderProjectsGrid();
  }

  function renderProjectSwitcher() {
    const nav = $('#project-switcher');
    nav.innerHTML = '';
    state.projects.forEach(p => {
      const chip = document.createElement('button');
      chip.className = 'crumb-chip' + (state.currentProject && state.currentProject.id === p.id ? ' active' : '');
      chip.textContent = p.name;
      chip.addEventListener('click', () => openBoard(p.id));
      nav.appendChild(chip);
    });
  }

  function renderProjectsGrid() {
    const grid = $('#projects-grid');
    grid.innerHTML = '';
    $('#projects-empty').classList.toggle('hidden', state.projects.length > 0);

    state.projects.forEach(p => {
      const card = document.createElement('div');
      card.className = 'project-card';
      card.innerHTML = `
        <h3>${escapeHtml(p.name)}</h3>
        <p>${escapeHtml(p.description || 'No description yet.')}</p>
        <div class="project-card-meta">
          <span>${p.taskCount} ticket${p.taskCount === 1 ? '' : 's'}</span>
          <div class="avatar-stack">
            ${p.members.slice(0, 4).map(m => `<div class="avatar" title="${escapeHtml(m.name)}">${initials(m.name)}</div>`).join('')}
          </div>
        </div>
      `;
      card.addEventListener('click', () => openBoard(p.id));
      grid.appendChild(card);
    });
  }

  function showProjectsView() {
    state.currentProject = null;
    $('#projects-view').classList.remove('hidden');
    $('#board-view').classList.add('hidden');
    renderProjectSwitcher();
  }

  function initProjectModal() {
    $('#new-project-btn').addEventListener('click', () => openModal('project-modal'));
    $('#empty-new-project-btn').addEventListener('click', () => openModal('project-modal'));

    $('#project-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('#project-name').value.trim();
      const description = $('#project-desc').value.trim();
      $('#project-error').textContent = '';
      try {
        await api('/projects', { method: 'POST', body: { name, description } });
        closeModal('project-modal');
        e.target.reset();
        await loadProjects();
        toast('Project created.');
      } catch (err) {
        $('#project-error').textContent = err.message;
      }
    });
  }

  // ------------------------------ board view --------------------------------

  async function openBoard(projectId) {
    try {
      const data = await api(`/projects/${projectId}`);
      state.currentProject = data.project;
      $('#projects-view').classList.add('hidden');
      $('#board-view').classList.remove('hidden');
      $('#board-project-name').textContent = data.project.name;
      $('#board-project-desc').textContent = data.project.description || '';
      renderProjectSwitcher();
      await loadTasks();
    } catch (err) {
      toast(err.message, true);
    }
  }

  async function loadTasks() {
    if (!state.currentProject) return;
    const data = await api(`/projects/${state.currentProject.id}/tasks`);
    state.tasks = data.tasks;
    renderBoard();
  }

  function renderBoard() {
    ['todo', 'in_progress', 'done'].forEach(status => {
      const col = $(`#column-${status}`);
      col.innerHTML = '';
      const tasksForCol = state.tasks.filter(t => t.status === status);
      $(`#count-${status}`).textContent = tasksForCol.length;
      tasksForCol.forEach(t => col.appendChild(renderTaskCard(t)));
    });
  }

  function renderTaskCard(task) {
    const card = document.createElement('div');
    card.className = 'task-card';
    card.draggable = true;
    card.dataset.taskId = task.id;

    const assignee = task.assigneeId
      ? state.currentProject.members.find(m => m.id === task.assigneeId)
      : null;

    card.innerHTML = `
      <div class="task-card-top">
        <span class="ticket-id">${ticketRef(task.id)}</span>
        <span class="priority-dot priority-${task.priority}" title="${task.priority} priority"></span>
      </div>
      <p class="task-card-title">${escapeHtml(task.title)}</p>
      <div class="task-card-bottom">
        <span class="task-card-assignee">
          ${assignee ? `<span class="avatar" style="margin-left:0;width:18px;height:18px;font-size:9px;">${initials(assignee.name)}</span> ${escapeHtml(assignee.name.split(' ')[0])}` : 'Unassigned'}
        </span>
        <span class="task-card-comments">${task.commentCount ? `💬 ${task.commentCount}` : ''}${task.dueDate ? ` &middot; ${formatDate(task.dueDate)}` : ''}</span>
      </div>
    `;

    card.addEventListener('click', () => openTaskModal(task.id));

    card.addEventListener('dragstart', () => {
      state.draggingTaskId = task.id;
      card.classList.add('dragging');
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      state.draggingTaskId = null;
    });

    return card;
  }

  function initDragAndDrop() {
    $$('.board-column').forEach(col => {
      col.addEventListener('dragover', (e) => {
        e.preventDefault();
        col.classList.add('drag-over');
      });
      col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
      col.addEventListener('drop', async (e) => {
        e.preventDefault();
        col.classList.remove('drag-over');
        const taskId = state.draggingTaskId;
        if (!taskId) return;
        const newStatus = col.dataset.status;
        const task = state.tasks.find(t => t.id === taskId);
        if (!task || task.status === newStatus) return;

        task.status = newStatus; // optimistic update
        renderBoard();
        try {
          await api(`/tasks/${taskId}`, { method: 'PUT', body: { status: newStatus } });
        } catch (err) {
          toast(err.message, true);
          await loadTasks();
        }
      });
    });

    $('#back-to-projects').addEventListener('click', () => {
      showProjectsView();
    });
  }

  // ------------------------------ task modal --------------------------------

  function populateAssigneeOptions() {
    const select = $('#task-assignee');
    select.innerHTML = '<option value="">Unassigned</option>';
    state.currentProject.members.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.name;
      select.appendChild(opt);
    });
  }

  function openNewTaskModal() {
    state.currentTaskId = null;
    $('#task-modal-title').textContent = 'New ticket';
    $('#task-ticket-id').textContent = '';
    $('#task-form').reset();
    $('#task-error').textContent = '';
    $('#delete-task-btn').classList.add('hidden');
    populateAssigneeOptions();
    $('#comments-list').innerHTML = '<p class="comment-empty">Save the ticket to start a discussion.</p>';
    $('#comment-form').classList.add('hidden');
    openModal('task-modal');
  }

  async function openTaskModal(taskId) {
    state.currentTaskId = taskId;
    const task = state.tasks.find(t => t.id === taskId);
    if (!task) return;

    $('#task-modal-title').textContent = 'Edit ticket';
    $('#task-ticket-id').textContent = ticketRef(task.id);
    $('#task-error').textContent = '';
    $('#delete-task-btn').classList.remove('hidden');
    $('#comment-form').classList.remove('hidden');

    populateAssigneeOptions();
    $('#task-title').value = task.title;
    $('#task-desc').value = task.description || '';
    $('#task-status').value = task.status;
    $('#task-priority').value = task.priority;
    $('#task-assignee').value = task.assigneeId || '';
    $('#task-due').value = task.dueDate ? task.dueDate.slice(0, 10) : '';

    openModal('task-modal');
    await loadComments(taskId);
  }

  function initTaskModal() {
    $('#new-task-btn').addEventListener('click', openNewTaskModal);

    $('#task-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('#task-error').textContent = '';
      const payload = {
        title: $('#task-title').value.trim(),
        description: $('#task-desc').value.trim(),
        status: $('#task-status').value,
        priority: $('#task-priority').value,
        assigneeId: $('#task-assignee').value || null,
        dueDate: $('#task-due').value || null
      };

      try {
        if (state.currentTaskId) {
          await api(`/tasks/${state.currentTaskId}`, { method: 'PUT', body: payload });
        } else {
          await api(`/projects/${state.currentProject.id}/tasks`, { method: 'POST', body: payload });
        }
        closeModal('task-modal');
        await loadTasks();
        toast(state.currentTaskId ? 'Ticket updated.' : 'Ticket created.');
      } catch (err) {
        $('#task-error').textContent = err.message;
      }
    });

    $('#delete-task-btn').addEventListener('click', async () => {
      if (!state.currentTaskId) return;
      if (!confirm('Delete this ticket? This also removes its comments.')) return;
      try {
        await api(`/tasks/${state.currentTaskId}`, { method: 'DELETE' });
        closeModal('task-modal');
        await loadTasks();
        toast('Ticket deleted.');
      } catch (err) {
        toast(err.message, true);
      }
    });
  }

  // ------------------------------ comments -----------------------------------

  async function loadComments(taskId) {
    const list = $('#comments-list');
    list.innerHTML = '<p class="comment-empty">Loading...</p>';
    try {
      const data = await api(`/tasks/${taskId}/comments`);
      renderComments(data.comments);
    } catch (err) {
      list.innerHTML = `<p class="comment-empty">${escapeHtml(err.message)}</p>`;
    }
  }

  function renderComments(comments) {
    const list = $('#comments-list');
    list.innerHTML = '';
    if (comments.length === 0) {
      list.innerHTML = '<p class="comment-empty">No comments yet — start the conversation.</p>';
      return;
    }
    comments.forEach(c => {
      const el = document.createElement('div');
      el.className = 'comment';
      el.innerHTML = `
        <div class="comment-meta">
          <span class="comment-author">${escapeHtml(c.author ? c.author.name : 'Unknown')}</span>
          <span>${formatDate(c.createdAt)}</span>
        </div>
        <div class="comment-text">${escapeHtml(c.text)}</div>
      `;
      list.appendChild(el);
    });
    list.scrollTop = list.scrollHeight;
  }

  function initCommentForm() {
    $('#comment-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!state.currentTaskId) return;
      const textEl = $('#comment-text');
      const text = textEl.value.trim();
      if (!text) return;
      try {
        await api(`/tasks/${state.currentTaskId}/comments`, { method: 'POST', body: { text } });
        textEl.value = '';
        await loadComments(state.currentTaskId);
        await loadTasks(); // refresh comment counts on cards
      } catch (err) {
        toast(err.message, true);
      }
    });
  }

  // ------------------------------ members modal -------------------------------

  function initMembersModal() {
    $('#manage-members-btn').addEventListener('click', () => {
      renderMembersList();
      openModal('members-modal');
    });

    $('#add-member-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = $('#member-email').value.trim();
      $('#member-error').textContent = '';
      try {
        const data = await api(`/projects/${state.currentProject.id}/members`, { method: 'POST', body: { email } });
        state.currentProject = data.project;
        $('#member-email').value = '';
        renderMembersList();
        renderProjectSwitcher();
        toast('Teammate added.');
      } catch (err) {
        $('#member-error').textContent = err.message;
      }
    });
  }

  function renderMembersList() {
    const list = $('#members-list');
    list.innerHTML = '';
    const project = state.currentProject;
    project.members.forEach(m => {
      const row = document.createElement('div');
      row.className = 'member-row';
      const isOwner = m.id === project.ownerId;
      row.innerHTML = `
        <span>${escapeHtml(m.name)} <span class="member-email">${escapeHtml(m.email)}</span>${isOwner ? ' &middot; owner' : ''}</span>
        ${(!isOwner && project.ownerId === state.user.id) ? `<button class="member-remove" data-user-id="${m.id}">Remove</button>` : ''}
      `;
      list.appendChild(row);
    });

    $$('.member-remove', list).forEach(btn => {
      btn.addEventListener('click', async () => {
        try {
          const data = await api(`/projects/${project.id}/members/${btn.dataset.userId}`, { method: 'DELETE' });
          state.currentProject = data.project;
          renderMembersList();
          renderProjectSwitcher();
          await loadTasks();
        } catch (err) {
          toast(err.message, true);
        }
      });
    });
  }

  // ------------------------------ utils ---------------------------------------

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str == null ? '' : String(str);
    return div.innerHTML;
  }

  // ------------------------------ boot -----------------------------------------

  async function boot() {
    if (!state.token) {
      showAuthScreen();
      return;
    }
    try {
      const me = await api('/auth/me');
      state.user = me.user;
      showAppShell();
      await loadProjects();
      showProjectsView();
    } catch (err) {
      signOut();
    }
  }

  function init() {
    initAuthTabs();
    initAuthForms();
    initModalCloses();
    initProjectModal();
    initDragAndDrop();
    initTaskModal();
    initCommentForm();
    initMembersModal();
    boot();
  }

  document.addEventListener('DOMContentLoaded', init);
})();
